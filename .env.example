# Copy to .env (not committed) or set these in your host's dashboard.
# Everything is optional; defaults are shown.

# PORT=4800
# NODE_ENV=production

# Random string of 32+ characters. Lets calls resume across server restarts
# and deploys. Without it, people rejoin automatically but video reconnects.
SESSION_SECRET=

# Meeting notes and "catch me up" work without any key: Peerly writes them
# itself from the transcript. For AI-written notes, add a free Groq key
# (https://console.groq.com/keys). If Groq is busy, the built-in notes stand in.
GROQ_API_KEY=
# ANTHROPIC_API_KEY=            # or use Claude instead
# AI_PROVIDER=auto              # auto | local | groq | anthropic | openai
# AI_MODEL=                     # default: openai/gpt-oss-120b (Groq), claude-opus-5 (Claude)
# AI_BASE_URL=                  # for AI_PROVIDER=openai (OpenRouter, Mistral, Ollama, ...)
# AI_API_KEY=                   # key for AI_PROVIDER=openai, if it needs one
# AI_MAX_REQUEST_TOKENS=7500    # long meetings are condensed to fit (Groq free tier: 8K/min)
# AI_LOCAL_FALLBACK=true        # built-in notes when the AI service fails
# AI_MAX_REQUESTS_PER_HOUR=60   # cap across the whole server

# Meetings
# MAX_ROOM_SIZE=8
# RECONNECT_GRACE_MS=30000      # how long a dropped participant keeps their seat
# REPORT_TTL_HOURS=24           # how long meeting notes stay available

# TURN relay for people behind strict firewalls (pick one credential style)
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=                  # coturn "use-auth-secret": short-lived credentials
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Operations
# LOG_LEVEL=info                # debug | info | warn | error
# METRICS_TOKEN=                # enables /metrics (Prometheus) behind a bearer token
# TRUST_PROXY=1                 # proxy hops, or "true" (default on Render)
# ALLOWED_ORIGINS=              # extra origins allowed to open WebSocket connections
