    "@mediapipe/tasks-vision": "^1.0.1",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "socket.io-client": "^4.8.3"
  }
}
