{
  "name": "peerly",
  "version": "2.0.0",
  "description": "Peer-to-peer video meetings with background effects, reactions, private messages, live captions and AI meeting notes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
